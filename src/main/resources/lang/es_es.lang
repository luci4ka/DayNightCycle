# ═══════════════════════════════════════════
#   DayNightCycle — Español (TerraCraft Style)
# ═══════════════════════════════════════════

# ─── Común ───
prefix=<gradient:#4CAF50:#FFC107><bold>DayNightCycle</bold></gradient> <#1B5E20>»

# ─── AFK (action bar) ───
afk.enabled=<#FFA726>😴 AFK
afk.disabled=<#4CAF50>✅ Activo de nuevo
afk.disabled.system=<#EF5350>❌ El sistema AFK está desactivado.
afk.manual.toggle=<#B0BEC5>AFK: <#FFFFFF>%state%
afk.state.on=<#4CAF50>activado
afk.state.off=<#EF5350>desactivado

# ─── Sueño ───
sleep.skip=<#FFA726>🌙 ¡Noche saltada! <#B0BEC5>(<#FFFFFF>%sleeping%<#B0BEC5>/<#FFFFFF>%required%<#B0BEC5> durmiendo)
sleep.animation.start=<#FFA726>⏩ La noche se está acelerando...

# ─── Ciclo ───
cycle.set.success=<#4CAF50>✅ Ciclo actualizado: <#FFFFFF>día %day% min<#4CAF50>, <#FFFFFF>noche %night% min

# ─── Comandos: reload ───
command.reload.success=<#4CAF50>✅ Configuración recargada.
command.reload.error=<#EF5350>❌ Error al recargar: <#FFFFFF>%error%
command.reload.error.console=<#EF5350>❌ Error al recargar. Revisa la consola.

# ─── Comandos: status ───
command.status.header=<gradient:#FFC107:#FFA726>▬▬▬▬▬ <bold>DayNightCycle</bold> ▬▬▬▬▬</gradient>
command.status.day=<#B0BEC5>☀ Día: <#FFFFFF>%day% <#B0BEC5>min
command.status.night=<#B0BEC5>🌙 Noche: <#FFFFFF>%night% <#B0BEC5>min
command.status.afk-timeout=<#B0BEC5>😴 AFK tras: <#FFFFFF>%timeout% <#B0BEC5>min
command.status.afk-players=<#B0BEC5>👤 AFK ahora: <#FFA726>%count%
command.status.footer=<gradient:#FFA726:#FFC107>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬</gradient>

# ─── Comandos: info ───
command.info.header=<gradient:#29B6F6:#4CAF50>▬▬▬▬▬ <bold>DayNightCycle</bold> ▬▬▬▬▬</gradient>
command.info.version=<#B0BEC5>Versión: <#FFFFFF>%version%
command.info.author=<#B0BEC5>Autor: <#FFFFFF>%author%
command.info.languages=<#B0BEC5>Idiomas: <#FFFFFF>%languages%
command.info.papi=<#B0BEC5>PlaceholderAPI: %state%
command.info.bstats=<#B0BEC5>bStats: %state%
command.info.footer=<gradient:#4CAF50:#29B6F6>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬</gradient>

# ─── Comandos: time ───
command.time.header=<gradient:#FFC107:#FFA726>▶ <bold>Hora del mundo</bold> ◀</gradient>
command.time.world=<#B0BEC5>▶ <gray>Mundo: <#FFFFFF>%world%
command.time.day=<#B0BEC5>▶ <gray>Hora: <#FFFFFF>%time% <#B0BEC5>(<#FFFFFF>%ticks% <#B0BEC5>ticks)
command.time.footer=<gradient:#FFA726:#FFC107>▶ ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬ ◀</gradient>

# ─── Time: mundos ───
command.time.world.overworld=<#4CAF50>Superficie
command.time.world.nether=<#EF5350>Inframundo
command.time.world.end=<#AB47BC>El End
command.time.world.other=<#B0BEC5>%world%

# ─── Estados ───
state.enabled=<#4CAF50>activado
state.disabled=<#EF5350>desactivado

# ─── Sleep override ───
sleeplist.header=<#B0BEC5>📋 Lista de override de sueño (<#FFFFFF>%count%<#B0BEC5>):
sleeplist.entry=<#B0BEC5> • <#FFFFFF>%player%
sleeplist.added=<#4CAF50>✅ Jugador <#FFFFFF>%player%<#4CAF50> añadido al override.
sleeplist.removed=<#4CAF50>✅ Jugador <#FFFFFF>%player%<#4CAF50> eliminado del override.
sleeplist.not-found=<#EF5350>❌ Jugador <#FFFFFF>%player%<#EF5350> no encontrado en la lista.
sleeplist.invalid-name=<#EF5350>❌ Nombre de jugador inválido: <#FFFFFF>%player%

# ─── Errores ───
error.no-permission=<#EF5350>❌ Permisos insuficientes.
error.unknown=<#EF5350>❌ Error desconocido: <#FFFFFF>%error%