# ═══════════════════════════════════════════
#   DayNightCycle — Беларуская (TerraCraft Style)
# ═══════════════════════════════════════════

# ─── Агульныя ───
prefix=<gradient:#4CAF50:#FFC107><bold>DayNightCycle</bold></gradient> <#1B5E20>»

# ─── AFK (action bar) ───
afk.enabled=<#FFA726>😴 AFK
afk.disabled=<#4CAF50>✅ Зноў актыўны
afk.disabled.system=<#EF5350>❌ AFK-сістэма адключана.
afk.manual.toggle=<#B0BEC5>AFK: <#FFFFFF>%state%
afk.state.on=<#4CAF50>укл
afk.state.off=<#EF5350>выкл

# ─── Сон ───
sleep.skip=<#FFA726>🌙 Ноч прапушчана! <#B0BEC5>(<#FFFFFF>%sleeping%<#B0BEC5>/<#FFFFFF>%required%<#B0BEC5> спячых)
sleep.animation.start=<#FFA726>⏩ Ноч паскараецца...

# ─── Цыкл ───
cycle.set.success=<#4CAF50>✅ Цыкл абноўлены: <#FFFFFF>дзень %day% хв<#4CAF50>, <#FFFFFF>ноч %night% хв

# ─── Каманды: reload ───
command.reload.success=<#4CAF50>✅ Канфігурацыя перазагружана.
command.reload.error=<#EF5350>❌ Памылка перазагрузкі: <#FFFFFF>%error%
command.reload.error.console=<#EF5350>❌ Памылка перазагрузкі. Падрабязнасці ў кансолі.

# ─── Каманды: status ───
command.status.header=<gradient:#FFC107:#FFA726>▬▬▬▬▬ <bold>DayNightCycle</bold> ▬▬▬▬▬</gradient>
command.status.day=<#B0BEC5>☀ Дзень: <#FFFFFF>%day% <#B0BEC5>хв
command.status.night=<#B0BEC5>🌙 Ноч: <#FFFFFF>%night% <#B0BEC5>хв
command.status.afk-timeout=<#B0BEC5>😴 AFK праз: <#FFFFFF>%timeout% <#B0BEC5>хв
command.status.afk-players=<#B0BEC5>👤 AFK зараз: <#FFA726>%count%
command.status.footer=<gradient:#FFA726:#FFC107>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬</gradient>

# ─── Каманды: info ───
command.info.header=<gradient:#29B6F6:#4CAF50>▬▬▬▬▬ <bold>DayNightCycle</bold> ▬▬▬▬▬</gradient>
command.info.version=<#B0BEC5>Версія: <#FFFFFF>%version%
command.info.author=<#B0BEC5>Аўтар: <#FFFFFF>%author%
command.info.languages=<#B0BEC5>Мовы: <#FFFFFF>%languages%
command.info.papi=<#B0BEC5>PlaceholderAPI: %state%
command.info.bstats=<#B0BEC5>bStats: %state%
command.info.footer=<gradient:#4CAF50:#29B6F6>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬</gradient>

# ─── Каманды: time ───
command.time.header=<gradient:#FFC107:#FFA726>▶ <bold>Час у свеце</bold> ◀</gradient>
command.time.world=<#B0BEC5>▶ <gray>Свет: <#FFFFFF>%world%
command.time.day=<#B0BEC5>▶ <gray>Час: <#FFFFFF>%time% <#B0BEC5>(<#FFFFFF>%ticks% <#B0BEC5>тыкаў)
command.time.footer=<gradient:#FFA726:#FFC107>▶ ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬ ◀</gradient>

# ─── Time: светы ───
command.time.world.overworld=<#4CAF50>Выжыванне
command.time.world.nether=<#EF5350>Ніжні
command.time.world.end=<#AB47BC>Край
command.time.world.other=<#B0BEC5>%world%

# ─── Станы ───
state.enabled=<#4CAF50>уключаны
state.disabled=<#EF5350>выключаны

# ─── Sleep override ───
sleeplist.header=<#B0BEC5>📋 Спіс override сну (<#FFFFFF>%count%<#B0BEC5>):
sleeplist.entry=<#B0BEC5> • <#FFFFFF>%player%
sleeplist.added=<#4CAF50>✅ Гулец <#FFFFFF>%player%<#4CAF50> дададзены ў override.
sleeplist.removed=<#4CAF50>✅ Гулец <#FFFFFF>%player%<#4CAF50> выдалены з override.
sleeplist.not-found=<#EF5350>❌ Гулец <#FFFFFF>%player%<#EF5350> не знойдзены ў спісе.
sleeplist.invalid-name=<#EF5350>❌ Няправільнае імя гульца: <#FFFFFF>%player%

# ─── Памылкі ───
error.no-permission=<#EF5350>❌ Недастаткова правоў.
error.unknown=<#EF5350>❌ Невядомая памылка: <#FFFFFF>%error%