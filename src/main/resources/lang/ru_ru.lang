# ═══════════════════════════════════════════
#   DayNightCycle — Русский язык (TerraCraft Style)
# ═══════════════════════════════════════════

# ─── Общие ───
prefix=<gradient:#4CAF50:#FFC107><bold>DayNightCycle</bold></gradient> <#1B5E20>»

# ─── AFK (action bar) ───
afk.enabled=<#FFA726>😴 AFK
afk.disabled=<#4CAF50>✅ Снова активен
afk.disabled.system=<#EF5350>❌ AFK-система отключена.
afk.manual.toggle=<#B0BEC5>AFK: <#FFFFFF>%state%
afk.state.on=<#4CAF50>вкл
afk.state.off=<#EF5350>выкл

# ─── Сон ───
sleep.skip=<#FFA726>🌙 Ночь пропущена! <#B0BEC5>(<#FFFFFF>%sleeping%<#B0BEC5>/<#FFFFFF>%required%<#B0BEC5> спящих)
sleep.animation.start=<#FFA726>⏩ Ночь ускоряется...

# ─── Цикл ───
cycle.set.success=<#4CAF50>✅ Цикл обновлён: <#FFFFFF>день %day% мин<#4CAF50>, <#FFFFFF>ночь %night% мин

# ─── Команды: reload ───
command.reload.success=<#4CAF50>✅ Конфигурация перезагружена.
command.reload.error=<#EF5350>❌ Ошибка перезагрузки: <#FFFFFF>%error%
command.reload.error.console=<#EF5350>❌ Ошибка перезагрузки. Подробности в консоли.

# ─── Команды: status ───
command.status.header=<gradient:#FFC107:#FFA726>▬▬▬▬▬ <bold>DayNightCycle</bold> ▬▬▬▬▬</gradient>
command.status.day=<#B0BEC5>☀ День: <#FFFFFF>%day% <#B0BEC5>мин
command.status.night=<#B0BEC5>🌙 Ночь: <#FFFFFF>%night% <#B0BEC5>мин
command.status.afk-timeout=<#B0BEC5>😴 AFK через: <#FFFFFF>%timeout% <#B0BEC5>мин
command.status.afk-players=<#B0BEC5>👤 AFK сейчас: <#FFA726>%count%
command.status.footer=<gradient:#FFA726:#FFC107>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬</gradient>

# ─── Команды: info ───
command.info.header=<gradient:#29B6F6:#4CAF50>▬▬▬▬▬ <bold>DayNightCycle</bold> ▬▬▬▬▬</gradient>
command.info.version=<#B0BEC5>Версия: <#FFFFFF>%version%
command.info.author=<#B0BEC5>Автор: <#FFFFFF>%author%
command.info.languages=<#B0BEC5>Языки: <#FFFFFF>%languages%
command.info.papi=<#B0BEC5>PlaceholderAPI: %state%
command.info.bstats=<#B0BEC5>bStats: %state%
command.info.footer=<gradient:#4CAF50:#29B6F6>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬</gradient>

# ─── Команды: time ───
command.time.header=<gradient:#FFC107:#FFA726>▶ <bold>Время в мире</bold> ◀</gradient>
command.time.world=<#B0BEC5>▶ <gray>Мир: <#FFFFFF>%world%
command.time.day=<#B0BEC5>▶ <gray>Время: <#FFFFFF>%time% <#B0BEC5>(<#FFFFFF>%ticks% <#B0BEC5>тиков)
command.time.footer=<gradient:#FFA726:#FFC107>▶ ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬ ◀</gradient>

# ─── Time: миры ───
command.time.world.overworld=<#4CAF50>Выживание
command.time.world.nether=<#EF5350>Ад
command.time.world.end=<#AB47BC>Край
command.time.world.other=<#B0BEC5>%world%

# ─── Состояния ───
state.enabled=<#4CAF50>включён
state.disabled=<#EF5350>выключен

# ─── Sleep override ───
sleeplist.header=<#B0BEC5>📋 Список override сна (<#FFFFFF>%count%<#B0BEC5>):
sleeplist.entry=<#B0BEC5> • <#FFFFFF>%player%
sleeplist.added=<#4CAF50>✅ Игрок <#FFFFFF>%player%<#4CAF50> добавлен в override.
sleeplist.removed=<#4CAF50>✅ Игрок <#FFFFFF>%player%<#4CAF50> удалён из override.
sleeplist.not-found=<#EF5350>❌ Игрок <#FFFFFF>%player%<#EF5350> не найден в списке.
sleeplist.invalid-name=<#EF5350>❌ Недопустимое имя игрока: <#FFFFFF>%player%

# ─── Ошибки ───
error.no-permission=<#EF5350>❌ Недостаточно прав.
error.unknown=<#EF5350>❌ Неизвестная ошибка: <#FFFFFF>%error%