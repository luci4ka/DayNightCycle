# ═══════════════════════════════════════════
#   DayNightCycle — Deutsch (TerraCraft Style)
# ═══════════════════════════════════════════

# ─── Allgemein ───
prefix=<gradient:#4CAF50:#FFC107><bold>DayNightCycle</bold></gradient> <#1B5E20>»

# ─── AFK (action bar) ───
afk.enabled=<#FFA726>😴 AFK
afk.disabled=<#4CAF50>✅ Wieder aktiv
afk.disabled.system=<#EF5350>❌ AFK-System ist deaktiviert.
afk.manual.toggle=<#B0BEC5>AFK: <#FFFFFF>%state%
afk.state.on=<#4CAF50>an
afk.state.off=<#EF5350>aus

# ─── Schlaf ───
sleep.skip=<#FFA726>🌙 Nacht übersprungen! <#B0BEC5>(<#FFFFFF>%sleeping%<#B0BEC5>/<#FFFFFF>%required%<#B0BEC5> schlafend)
sleep.animation.start=<#FFA726>⏩ Nacht wird beschleunigt...

# ─── Zyklus ───
cycle.set.success=<#4CAF50>✅ Zyklus aktualisiert: <#FFFFFF>Tag %day% Min<#4CAF50>, <#FFFFFF>Nacht %night% Min

# ─── Befehle: reload ───
command.reload.success=<#4CAF50>✅ Konfiguration neu geladen.
command.reload.error=<#EF5350>❌ Fehler beim Neuladen: <#FFFFFF>%error%
command.reload.error.console=<#EF5350>❌ Neuladen fehlgeschlagen. Details in der Konsole.

# ─── Befehle: status ───
command.status.header=<gradient:#FFC107:#FFA726>▬▬▬▬▬ <bold>DayNightCycle</bold> ▬▬▬▬▬</gradient>
command.status.day=<#B0BEC5>☀ Tag: <#FFFFFF>%day% <#B0BEC5>Min
command.status.night=<#B0BEC5>🌙 Nacht: <#FFFFFF>%night% <#B0BEC5>Min
command.status.afk-timeout=<#B0BEC5>😴 AFK nach: <#FFFFFF>%timeout% <#B0BEC5>Min
command.status.afk-players=<#B0BEC5>👤 AFK jetzt: <#FFA726>%count%
command.status.footer=<gradient:#FFA726:#FFC107>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬</gradient>

# ─── Befehle: info ───
command.info.header=<gradient:#29B6F6:#4CAF50>▬▬▬▬▬ <bold>DayNightCycle</bold> ▬▬▬▬▬</gradient>
command.info.version=<#B0BEC5>Version: <#FFFFFF>%version%
command.info.author=<#B0BEC5>Autor: <#FFFFFF>%author%
command.info.languages=<#B0BEC5>Sprachen: <#FFFFFF>%languages%
command.info.papi=<#B0BEC5>PlaceholderAPI: %state%
command.info.bstats=<#B0BEC5>bStats: %state%
command.info.footer=<gradient:#4CAF50:#29B6F6>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬</gradient>

# ─── Befehle: time ───
command.time.header=<gradient:#FFC107:#FFA726>▶ <bold>Weltzeit</bold> ◀</gradient>
command.time.world=<#B0BEC5>▶ <gray>Welt: <#FFFFFF>%world%
command.time.day=<#B0BEC5>▶ <gray>Zeit: <#FFFFFF>%time% <#B0BEC5>(<#FFFFFF>%ticks% <#B0BEC5>Ticks)
command.time.footer=<gradient:#FFA726:#FFC107>▶ ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬ ◀</gradient>

# ─── Time: Welten ───
command.time.world.overworld=<#4CAF50>Oberwelt
command.time.world.nether=<#EF5350>Nether
command.time.world.end=<#AB47BC>Ende
command.time.world.other=<#B0BEC5>%world%

# ─── Zustände ───
state.enabled=<#4CAF50>aktiviert
state.disabled=<#EF5350>deaktiviert

# ─── Sleep override ───
sleeplist.header=<#B0BEC5>📋 Schlaf-Override-Liste (<#FFFFFF>%count%<#B0BEC5>):
sleeplist.entry=<#B0BEC5> • <#FFFFFF>%player%
sleeplist.added=<#4CAF50>✅ Spieler <#FFFFFF>%player%<#4CAF50> zur Override-Liste hinzugefügt.
sleeplist.removed=<#4CAF50>✅ Spieler <#FFFFFF>%player%<#4CAF50> aus der Override-Liste entfernt.
sleeplist.not-found=<#EF5350>❌ Spieler <#FFFFFF>%player%<#EF5350> nicht in der Liste gefunden.
sleeplist.invalid-name=<#EF5350>❌ Ungültiger Spielername: <#FFFFFF>%player%

# ─── Fehler ───
error.no-permission=<#EF5350>❌ Keine Berechtigung.
error.unknown=<#EF5350>❌ Unbekannter Fehler: <#FFFFFF>%error%