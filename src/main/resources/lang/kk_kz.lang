# ═══════════════════════════════════════════
#   DayNightCycle — Қазақша (TerraCraft Style)
# ═══════════════════════════════════════════

# ─── Жалпы ───
prefix=<gradient:#4CAF50:#FFC107><bold>DayNightCycle</bold></gradient> <#1B5E20>»

# ─── AFK (action bar) ───
afk.enabled=<#FFA726>😴 AFK
afk.disabled=<#4CAF50>✅ Қайта белсенді
afk.disabled.system=<#EF5350>❌ AFK жүйесі өшірулі.
afk.manual.toggle=<#B0BEC5>AFK: <#FFFFFF>%state%
afk.state.on=<#4CAF50>қосулы
afk.state.off=<#EF5350>өшірулі

# ─── Ұйқы ───
sleep.skip=<#FFA726>🌙 Түн өткізілді! <#B0BEC5>(<#FFFFFF>%sleeping%<#B0BEC5>/<#FFFFFF>%required%<#B0BEC5> ұйықтаған)
sleep.animation.start=<#FFA726>⏩ Түн жылдамдатылуда...

# ─── Цикл ───
cycle.set.success=<#4CAF50>✅ Цикл жаңартылды: <#FFFFFF>күн %day% мин<#4CAF50>, <#FFFFFF>түн %night% мин

# ─── Командалар: reload ───
command.reload.success=<#4CAF50>✅ Конфигурация қайта жүктелді.
command.reload.error=<#EF5350>❌ Қайта жүктеу қатесі: <#FFFFFF>%error%
command.reload.error.console=<#EF5350>❌ Қайта жүктеу сәтсіз. Консольді тексеріңіз.

# ─── Командалар: status ───
command.status.header=<gradient:#FFC107:#FFA726>▬▬▬▬▬ <bold>DayNightCycle</bold> ▬▬▬▬▬</gradient>
command.status.day=<#B0BEC5>☀ Күн: <#FFFFFF>%day% <#B0BEC5>мин
command.status.night=<#B0BEC5>🌙 Түн: <#FFFFFF>%night% <#B0BEC5>мин
command.status.afk-timeout=<#B0BEC5>😴 AFK: <#FFFFFF>%timeout% <#B0BEC5>мин
command.status.afk-players=<#B0BEC5>👤 Қазір AFK: <#FFA726>%count%
command.status.footer=<gradient:#FFA726:#FFC107>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬</gradient>

# ─── Командалар: info ───
command.info.header=<gradient:#29B6F6:#4CAF50>▬▬▬▬▬ <bold>DayNightCycle</bold> ▬▬▬▬▬</gradient>
command.info.version=<#B0BEC5>Нұсқа: <#FFFFFF>%version%
command.info.author=<#B0BEC5>Автор: <#FFFFFF>%author%
command.info.languages=<#B0BEC5>Тілдер: <#FFFFFF>%languages%
command.info.papi=<#B0BEC5>PlaceholderAPI: %state%
command.info.bstats=<#B0BEC5>bStats: %state%
command.info.footer=<gradient:#4CAF50:#29B6F6>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬</gradient>

# ─── Командалар: time ───
command.time.header=<gradient:#FFC107:#FFA726>▶ <bold>Әлемдегі уақыт</bold> ◀</gradient>
command.time.world=<#B0BEC5>▶ <gray>Әлем: <#FFFFFF>%world%
command.time.day=<#B0BEC5>▶ <gray>Уақыт: <#FFFFFF>%time% <#B0BEC5>(<#FFFFFF>%ticks% <#B0BEC5>тик)
command.time.footer=<gradient:#FFA726:#FFC107>▶ ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬ ◀</gradient>

# ─── Time: әлемдер ───
command.time.world.overworld=<#4CAF50>Тіршілік
command.time.world.nether=<#EF5350>Төменгі
command.time.world.end=<#AB47BC>Шет
command.time.world.other=<#B0BEC5>%world%

# ─── Күйлер ───
state.enabled=<#4CAF50>қосулы
state.disabled=<#EF5350>өшірулі

# ─── Sleep override ───
sleeplist.header=<#B0BEC5>📋 Ұйқы override тізімі (<#FFFFFF>%count%<#B0BEC5>):
sleeplist.entry=<#B0BEC5> • <#FFFFFF>%player%
sleeplist.added=<#4CAF50>✅ Ойыншы <#FFFFFF>%player%<#4CAF50> override-ға қосылды.
sleeplist.removed=<#4CAF50>✅ Ойыншы <#FFFFFF>%player%<#4CAF50> override-дан жойылды.
sleeplist.not-found=<#EF5350>❌ Ойыншы <#FFFFFF>%player%<#EF5350> тізімде табылмады.
sleeplist.invalid-name=<#EF5350>❌ Жарамсыз ойыншы аты: <#FFFFFF>%player%

# ─── Қателер ───
error.no-permission=<#EF5350>❌ Рұқсат жеткіліксіз.
error.unknown=<#EF5350>❌ Белгісіз қате: <#FFFFFF>%error%