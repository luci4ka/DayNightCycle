# ═══════════════════════════════════════════
#   DayNightCycle — English (TerraCraft Style)
# ═══════════════════════════════════════════

# ─── Common ───
prefix=<gradient:#4CAF50:#FFC107><bold>DayNightCycle</bold></gradient> <#1B5E20>»

# ─── AFK (action bar) ───
afk.enabled=<#FFA726>😴 AFK
afk.disabled=<#4CAF50>✅ Active again
afk.disabled.system=<#EF5350>❌ AFK system is disabled.
afk.manual.toggle=<#B0BEC5>AFK: <#FFFFFF>%state%
afk.state.on=<#4CAF50>on
afk.state.off=<#EF5350>off

# ─── Sleep ───
sleep.skip=<#FFA726>🌙 Night skipped! <#B0BEC5>(<#FFFFFF>%sleeping%<#B0BEC5>/<#FFFFFF>%required%<#B0BEC5> sleeping)
sleep.animation.start=<#FFA726>⏩ Night is accelerating...

# ─── Cycle ───
cycle.set.success=<#4CAF50>✅ Cycle updated: <#FFFFFF>day %day% min<#4CAF50>, <#FFFFFF>night %night% min

# ─── Commands: reload ───
command.reload.success=<#4CAF50>✅ Configuration reloaded.
command.reload.error=<#EF5350>❌ Reload error: <#FFFFFF>%error%
command.reload.error.console=<#EF5350>❌ Reload failed. Check console for details.

# ─── Commands: status ───
command.status.header=<gradient:#FFC107:#FFA726>▬▬▬▬▬ <bold>DayNightCycle</bold> ▬▬▬▬▬</gradient>
command.status.day=<#B0BEC5>☀ Day: <#FFFFFF>%day% <#B0BEC5>min
command.status.night=<#B0BEC5>🌙 Night: <#FFFFFF>%night% <#B0BEC5>min
command.status.afk-timeout=<#B0BEC5>😴 AFK after: <#FFFFFF>%timeout% <#B0BEC5>min
command.status.afk-players=<#B0BEC5>👤 AFK now: <#FFA726>%count%
command.status.footer=<gradient:#FFA726:#FFC107>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬</gradient>

# ─── Commands: info ───
command.info.header=<gradient:#29B6F6:#4CAF50>▬▬▬▬▬ <bold>DayNightCycle</bold> ▬▬▬▬▬</gradient>
command.info.version=<#B0BEC5>Version: <#FFFFFF>%version%
command.info.author=<#B0BEC5>Author: <#FFFFFF>%author%
command.info.languages=<#B0BEC5>Languages: <#FFFFFF>%languages%
command.info.papi=<#B0BEC5>PlaceholderAPI: %state%
command.info.bstats=<#B0BEC5>bStats: %state%
command.info.footer=<gradient:#4CAF50:#29B6F6>▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬</gradient>

# ─── Commands: time ───
command.time.header=<gradient:#FFC107:#FFA726>▶ <bold>World Time</bold> ◀</gradient>
command.time.world=<#B0BEC5>▶ <gray>World: <#FFFFFF>%world%
command.time.day=<#B0BEC5>▶ <gray>Time: <#FFFFFF>%time% <#B0BEC5>(<#FFFFFF>%ticks% <#B0BEC5>ticks)
command.time.footer=<gradient:#FFA726:#FFC107>▶ ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬ ◀</gradient>

# ─── Time: worlds ───
command.time.world.overworld=<#4CAF50>Overworld
command.time.world.nether=<#EF5350>Nether
command.time.world.end=<#AB47BC>The End
command.time.world.other=<#B0BEC5>%world%

# ─── States ───
state.enabled=<#4CAF50>enabled
state.disabled=<#EF5350>disabled

# ─── Sleep override ───
sleeplist.header=<#B0BEC5>📋 Sleep override list (<#FFFFFF>%count%<#B0BEC5>):
sleeplist.entry=<#B0BEC5> • <#FFFFFF>%player%
sleeplist.added=<#4CAF50>✅ Player <#FFFFFF>%player%<#4CAF50> added to override.
sleeplist.removed=<#4CAF50>✅ Player <#FFFFFF>%player%<#4CAF50> removed from override.
sleeplist.not-found=<#EF5350>❌ Player <#FFFFFF>%player%<#EF5350> not found in list.
sleeplist.invalid-name=<#EF5350>❌ Invalid player name: <#FFFFFF>%player%

# ─── Errors ───
error.no-permission=<#EF5350>❌ Insufficient permissions.
error.unknown=<#EF5350>❌ Unknown error: <#FFFFFF>%error%